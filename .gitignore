# Deny everything at the repo root by default
/*

# Allowed
!/.gitignore
!/.dockerignore
!/LICENSE
!/CMakeLists.txt
!/Dockerfile
!/README.md
!/compose.yaml
!/frontend/
!/backend/
!/src/
!/io.github.tonyp7.PS3Dec.yml

# .github/: only track workflows/, leave prompts/skills/etc. ignored
!/.github/
/.github/*
!/.github/workflows/

